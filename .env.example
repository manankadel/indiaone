# Dell deployment: use the private PostgreSQL service on the Docker network.
FOOD_DATABASE_URL=postgresql://user:password@postgres:5432/blueblood
FOOD_DATABASE_SSL=false
FOOD_DATABASE_POOL_MAX=10
# Cloud deployments can use one of these aliases instead.
POSTGRES_URL=
# Optional: non-pooled connection for migrations/admin tasks.
POSTGRES_URL_NON_POOLING=
FOOD_AUTHORITY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
